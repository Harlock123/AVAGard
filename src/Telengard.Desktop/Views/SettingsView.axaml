<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Telengard.Desktop.ViewModels"
             x:Class="Telengard.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <Border Classes="panel" Margin="40" MaxWidth="900">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Settings" Classes="h2" Margin="0,0,0,10" />
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                <Button Content="Save" Command="{Binding SaveCommand}" />
                <Button Content="Cancel (Esc)" Command="{Binding CancelCommand}" />
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Foreground="{StaticResource InfoBrush}" />
            </StackPanel>
            <ScrollViewer>
                <StackPanel Spacing="10">
                    <TextBlock Text="Modern rules timing" FontWeight="Bold" />
                    <CheckBox IsChecked="{Binding ModernDeliberate}" Content="Deliberate mode: no time limit on decisions (changes the original real-time rule)" />
                    <StackPanel Orientation="Horizontal" Spacing="10" IsEnabled="{Binding !ModernDeliberate}">
                        <TextBlock Text="Seconds per decision" VerticalAlignment="Center" Width="180" />
                        <Slider Minimum="2" Maximum="15" Value="{Binding ModernSeconds}" Width="260" TickFrequency="0.5" IsSnapToTickEnabled="True" />
                        <TextBlock Text="{Binding ModernSeconds, StringFormat='{}{0:0.0} s'}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Classic always uses the reference timing (about 3.7 s per decision)." FontSize="12" Foreground="{StaticResource InkDim}" />

                    <TextBlock Text="Rules options (both presets)" FontWeight="Bold" Margin="0,8,0,0" />
                    <CheckBox IsChecked="{Binding ManualDeathRule}"
                              Content="Manual death rule: erase a dead character's stored copy unless its name starts with SV (from the printed manual; the C64 program does not do this)" />

                    <TextBlock Text="Presentation" FontWeight="Bold" Margin="0,8,0,0" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Interface scale" VerticalAlignment="Center" Width="180" />
                        <Slider Minimum="0.75" Maximum="2.5" Value="{Binding UiScale}" Width="260" TickFrequency="0.05" IsSnapToTickEnabled="True" />
                        <TextBlock Text="{Binding UiScale, StringFormat='{}{0:P0}'}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Classic message pauses" VerticalAlignment="Center" Width="180" />
                        <Slider Minimum="0" Maximum="2" Value="{Binding ClassicPacing}" Width="260" />
                        <TextBlock Text="{Binding ClassicPacing, StringFormat='{}{0:0.00}×'}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Modern message pauses" VerticalAlignment="Center" Width="180" />
                        <Slider Minimum="0" Maximum="2" Value="{Binding ModernPacing}" Width="260" />
                        <TextBlock Text="{Binding ModernPacing, StringFormat='{}{0:0.00}×'}" VerticalAlignment="Center" />
                    </StackPanel>
                    <CheckBox IsChecked="{Binding HighContrast}" Content="High-contrast dungeon colours" />
                    <CheckBox IsChecked="{Binding ReducedMotion}" Content="Reduced motion" />
                    <CheckBox IsChecked="{Binding ShowAutomap}" Content="Show the automap in Modern games" />

                    <TextBlock Text="Dungeon keys (Modern)" FontWeight="Bold" Margin="0,8,0,0" />
                    <ItemsControl ItemsSource="{Binding Bindings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:BindingRow">
                                <Grid ColumnDefinitions="200,*,Auto" Margin="0,2">
                                    <TextBlock Text="{Binding Command}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Keys}" VerticalAlignment="Center" Foreground="{StaticResource Gold}" />
                                    <Button Grid.Column="2" Content="Rebind" Command="{Binding RebindCommand}" Focusable="False" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Reset keys to defaults" Command="{Binding ResetBindingsCommand}" Focusable="False" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
