<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Telengard.Desktop.ViewModels"
        xmlns:v="using:Telengard.Desktop.Views"
        x:Class="Telengard.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="AVAGard"
        Width="1180" Height="780" MinWidth="760" MinHeight="560"
        Background="{StaticResource WindowBrush}">
    <LayoutTransformControl>
        <LayoutTransformControl.LayoutTransform>
            <ScaleTransform ScaleX="{Binding UiScale}" ScaleY="{Binding UiScale}" />
        </LayoutTransformControl.LayoutTransform>
        <ContentControl Content="{Binding Current}">
            <ContentControl.DataTemplates>
                <DataTemplate DataType="vm:TitleViewModel"><v:TitleView /></DataTemplate>
                <DataTemplate DataType="vm:CreationViewModel"><v:CreationView /></DataTemplate>
                <DataTemplate DataType="vm:GameViewModel"><v:GameView /></DataTemplate>
                <DataTemplate DataType="vm:SettingsViewModel"><v:SettingsView /></DataTemplate>
                <DataTemplate DataType="vm:HelpViewModel"><v:HelpView /></DataTemplate>
            </ContentControl.DataTemplates>
        </ContentControl>
    </LayoutTransformControl>
</Window>
