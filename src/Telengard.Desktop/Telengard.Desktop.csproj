<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>AVAGard</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- Sound packs and ambience ship as loose files so players can add their own (see CREDITS). -->
    <Content Include="soundpacks\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="ambience\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Telengard.Core\Telengard.Core.csproj" />
    <ProjectReference Include="..\Telengard.Infrastructure\Telengard.Infrastructure.csproj" />
    <ProjectReference Include="..\Telengard.Audio\Telengard.Audio.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Telengard.Desktop.Tests" />
  </ItemGroup>
</Project>
